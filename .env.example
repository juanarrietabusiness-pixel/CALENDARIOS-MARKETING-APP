# ============================================================
# Variables de entorno — Juancito Ads
#
# Desarrollo local:  cp .env.example .env
#
# En producción viven en dos sitios distintos, y no es arbitrario:
#
#   NETLIFY   → lo que necesita el sitio y la función de alta del
#               administrador.
#   SUPABASE  → los secretos que usan las Edge Functions (Project
#               Settings → Edge Functions → Secrets).
#
# Las funciones de IA están en Supabase porque Netlify corta las
# peticiones a los 10 s (26 s en Pro) y generar un lote de 6
# publicaciones con Anthropic tarda unos 40 s. Supabase da 150 s.
# ============================================================


# ============================================================
# EN NETLIFY
# ============================================================

# ---- Navegador ----
# Todo lo que empieza por VITE_ se incrusta en el JavaScript que
# descarga el navegador. Aquí SÓLO van claves públicas.
#
# Ojo: estas dos hacen falta EN EL BUILD. Sin ellas, la aplicación se
# compila sin el panel (el código queda como rama muerta y rollup lo
# elimina) y el sitio sólo muestra un aviso de configuración. Al
# crearlas en Netlify, asegúrate de que su ámbito incluye «Builds».
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Servidor (funciones de Netlify) ----
# Nunca llevan el prefijo VITE_. La clave de servicio ignora RLS y da
# acceso total al proyecto: si se filtra, revócala inmediatamente.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Credenciales del administrador ----
# Las usa /api/admin-seed para crear (o actualizar) el usuario en
# Supabase Auth. Es la cuenta con la que inicias sesión en el panel.
# La contraseña debe tener 12 caracteres como mínimo.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Protege /api/admin-seed. Sin esta variable la función se niega a
# ejecutarse. Genera un valor largo al azar y BÓRRALO de Netlify
# cuando hayas terminado el alta.
#   openssl rand -hex 32
ADMIN_SEED_TOKEN=


# ============================================================
# EN SUPABASE  (Project Settings → Edge Functions → Secrets)
# ============================================================

# ---- Claves de IA ----
# Al menos una. Con las dos definidas manda AI_PROVIDER; si no está,
# se usa Anthropic.
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# anthropic | groq
AI_PROVIDER=anthropic

# Opcionales. Por defecto claude-haiku-4-5-20251001, que es rápido y
# barato para generar en lote. Para textos más cuidados en español:
#   AI_MODEL=claude-sonnet-5
# AI_MODEL=
# GROQ_MODEL=

# ---- GitHub ----
# Un único token de sólo lectura para leer el ADN de marca de los
# repositorios de los clientes. Sustituye al token por cliente que
# antes se guardaba en el navegador.
GITHUB_TOKEN=

# ---- CORS ----
# Orígenes que pueden llamar a las Edge Functions, separados por comas.
# Vacío = se refleja el origen (cómodo en local, no en producción).
# ALLOWED_ORIGINS=https://calendarios.midominio.com
