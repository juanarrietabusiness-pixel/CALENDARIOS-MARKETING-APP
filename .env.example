# ============================================================
# Variables de entorno — Juancito Ads
#
# Copia este archivo a `.env` para desarrollo local:
#     cp .env.example .env
#
# En producción se configuran en Netlify:
#     Site configuration → Environment variables
# (o con el MCP de Netlify: "añade estas variables de entorno al sitio")
#
# La aplicación arranca sin ninguna de estas variables: los datos se
# guardan en el navegador. Cada bloque activa una capacidad extra.
# ============================================================


# ---- Supabase (opcional) ----
# Necesarias para que los calendarios y las aprobaciones se guarden en
# la base de datos en lugar de sólo en el navegador.
#
# Dónde encontrarlas: Supabase → Project Settings → API
#
# VITE_*  se incrusta en el paquete del navegador → SÓLO claves públicas.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Las usa únicamente la función de Netlify (servidor). Nunca lleva
# prefijo VITE_: eso la publicaría en el JavaScript del navegador.
# La clave de servicio ignora RLS y da acceso total al proyecto.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# ---- CORS (opcional) ----
# Netlify define `URL` automáticamente con la URL del sitio, que ya se
# permite. Añade aquí orígenes extra separados por comas (por ejemplo un
# dominio propio) si los necesitas.
# ALLOWED_ORIGINS=https://calendarios.midominio.com


# ---- IA (opcional) ----
# La clave de IA la introduce cada usuario en la propia aplicación y se
# guarda en su navegador; no se configura aquí.
#
# Si en el futuro se mueven las llamadas de IA al servidor (recomendado,
# ver docs/auditoria-ux-ui.md), estas serían las variables:
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
