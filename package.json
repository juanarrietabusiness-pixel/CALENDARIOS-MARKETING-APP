{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "lint": "oxlint",
    "build": "vite build",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "sembrar": "node scripts/sembrar-admin.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bundle": "vitest run --config vitest.bundle.config.js",
    "test:vivo": "vitest run --config vitest.vivo.config.js",
    "test:infra": "vitest run --config vitest.infra.config.js",
    "verificar": "npm run lint && npm test && npm run build && npm run test:bundle && npm run test:vivo"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.45.0",
    "ws": "^8.21.3"
  }
}
